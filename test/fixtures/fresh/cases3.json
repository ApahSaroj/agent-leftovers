{
  "bg-cmdsub": ["nohup \"$(touch /tmp/pwn-bg)\" &"],
  "bg-backtick": ["nohup \"`id`\" --x &"],
  "bg-quote-dq": ["nohup \"a\\\"b\" &"],
  "bg-flag-cmdsub": [{"cmd": "\"$(id)\" serve", "bg": true}],
  "bg-script-weird": ["nohup python3 \"my;id.py\" &"],
  "spend-weird-file": [{"write": "/w/x/$(id).py", "content": "from openai import OpenAI\nimport os\nc=OpenAI(api_key=os.environ['OPENAI_API_KEY'])\nfor i in range(100): c.chat.completions.create(model='x',messages=[])"}, "nohup python3 '$(id).py' &"],
  "ngrok-weird": ["ngrok http '3000;id' > /dev/null &"],
  "aws-tag-region-filter": ["aws ec2 run-instances --region us-east-2 --image-id ami-1 --instance-type t3.micro"],
  "gke-ctx-weird-project": ["gcloud container clusters create k --zone us-central1-a --project 'p$(id)'", "gcloud container clusters get-credentials k --zone us-central1-a --project 'p$(id)'", "kubectl expose deployment web --type=LoadBalancer --port 80"],
  "k8s-ctx-flag": ["kubectl --context 'c;id' expose deployment web --type=LoadBalancer --port 80"],
  "k8s-ns-weird": ["kubectl -n 'n$(id)' expose deployment web --type=LoadBalancer --port 80"],
  "helm-ns-weird": ["helm install rel bitnami/redis -n 'n$(id)'"],
  "az-rg-weird": ["az vm create -g 'rg$(id)' -n vmw --image Ubuntu2204"],
  "aws-profile-weird": ["aws --profile 'p$(id)' s3 mb s3://pw-bucket"],
  "cf-r2-jur": ["wrangler r2 bucket create b1 --jurisdiction 'eu;id'"],
  "fly-app-flag": ["fly machine run nginx -a 'a$(id)'"],
  "heroku-addon": ["heroku addons:create heroku-postgresql:mini -a 'h$(id)'"],
  "supabase-ref": ["supabase functions deploy fn1 --project-ref 'r$(id)'"],
  "compose-envfile": ["docker compose --env-file '.env;id' up -d"],
  "orphan-disk-zone": ["gcloud compute instances create od --zone 'us-central1-a$(id)'", "gcloud compute instances delete od --zone 'us-central1-a$(id)' --keep-disks=boot"],
  "mcp-vercel": [{"mcp": "mcp__vercel__deploy_to_vercel", "input": {"name": "x$(id)"}, "out": "{\"id\":\"dpl_$(id)\",\"url\":\"https://x.vercel.app\"}"}],
  "mcp-supabase": [{"mcp": "mcp__supabase__create_project", "input": {"name": "s;id"}, "out": "{\"id\":\"abc$(id)\"}"}]
}
